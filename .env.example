# 内容工厂环境变量模板
# 复制为 .env 并填入真实值（.env 不会进版本库）
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# 图片生成模型（可选，用于视频封面素材增强）：
# IMG_MODEL=
# 发布通道密钥（申请后填入）：
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# 可选路径覆盖：
# FFMPEG_PATH=
# FFPROBE_PATH=
# FORGE_DATA=
# FORGE_STATE=
# FORGE_DB=
